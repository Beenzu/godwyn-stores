          <button class="btn" type="submit">Save product</button>
          <button class="btn ghost" type="button" onclick="cancelEditProduct()">Cancel</button>
        </div>
      </form>
    </div>` : ''}
    ${state.products.length === 0 ? `<div class="empty-state">No products yet — add your first one above.</div>` : `
    <table>
      <thead><tr><th></th><th>Name</th><th>Price</th><th>Qty</th><th></th></tr></thead>
      <tbody>
        ${state.products.map(p => `
        
:root{
  --bg:#ECE6D8;
  --surface:#FBF9F3;
  --ink:#1D2621;
  --ink-soft:#5B655F;
  --primary:#2F4A3E;
  --primary-dark:#20332A;
  --accent:#C0842C;
  --accent-soft:#EAD9B7;
  --alert:#8B3A2B;
  --alert-soft:#F0DBD4;
  --line:#D6CDB8;
  --radius:4px;
}
*{box-sizing:border-box;}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'IBM Plex Sans',sans-serif;font-size:15px;line-height:1.5;}
h1,h2,h3,.brand{font-family:'Fraunces',serif;}
button{font-family:inherit;cursor:pointer;}
input,select,textarea{font-family:inherit;font-size:15px;}
a{color:inherit;}

.topbar{background:var(--primary);color:#F3EFE3;padding:18px 24px;display:flex;align-items:center;justify-content:space-between;}
.brand{font-size:22px;font-weight:600;letter-spacing:0.2px;margin:0;}
.brand small{display:block;font-family:'IBM Plex Sans',sans-serif;font-size:12px;font-weight:400;color:#CBD8CE;margin-top:2px;}
.topbar-right{display:flex;align-items:center;gap:16px;}
.cart-pill{background:var(--accent);color:#2B1D08;border:none;border-radius:999px;padding:8px 16px;font-weight:600;font-size:14px;display:flex;align-items:center;gap:6px;}
.icon-link{color:#CBD8CE;font-size:13px;text-decoration:none;border-bottom:1px dotted #6E8377;padding-bottom:2px;}
.icon-link:hover{color:#fff;}

.wrap{max-width:1080px;margin:0 auto;padding:28px 24px 80px;}

.section-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:8px;}
.section-head h2{margin:0;font-size:20px;font-weight:600;}
.muted{color:var(--ink-soft);font-size:13px;}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:16px;display:flex;flex-direction:column;gap:8px;}
.swatch{width:100%;height:96px;border-radius:var(--radius);background:var(--accent-soft);display:flex;align-items:center;justify-content:center;font-size:36px;}
.card h3{margin:4px 0 0;font-size:16px;font-weight:600;}
.card .desc{color:var(--ink-soft);font-size:13px;min-height:18px;}
.price-row{display:flex;align-items:center;justify-content:space-between;margin-top:auto;}
.price{font-family:'Fraunces',serif;font-weight:600;font-size:18px;}
.stock-note{font-size:12px;color:var(--ink-soft);}
.stock-note.low{color:var(--alert);font-weight:600;}
.stock-note.out{color:var(--alert);}
.qty-row{display:flex;align-items:center;gap:8px;margin-top:6px;}
.stepper{display:flex;align-items:center;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;}
.stepper button{background:var(--surface);border:none;width:28px;height:28px;font-size:16px;color:var(--primary);}
.stepper span{width:28px;text-align:center;font-size:14px;}
.btn{background:var(--primary);color:#fff;border:none;border-radius:var(--radius);padding:9px 14px;font-weight:600;font-size:14px;}
.btn:hover{background:var(--primary-dark);}
.btn.full{width:100%;}
.btn.ghost{background:transparent;color:var(--primary);border:1px solid var(--primary);}
.btn.alert{background:var(--alert);}
.btn.small{padding:6px 10px;font-size:13px;}
.btn:disabled{background:#B9BEB8;cursor:not-allowed;}

.cart-fab{position:fixed;bottom:20px;right:20px;box-shadow:0 4px 14px rgba(0,0,0,0.2);border-radius:999px;padding:12px 20px;}
.drawer-backdrop{position:fixed;inset:0;background:rgba(20,25,22,0.4);display:none;z-index:50;}
.drawer-backdrop.open{display:block;}
.drawer{position:fixed;top:0;right:0;height:100%;width:min(400px,100%);background:var(--surface);z-index:51;transform:translateX(100%);transition:transform 0.25s ease;display:flex;flex-direction:column;}
.drawer.open{transform:translateX(0);}
.drawer-head{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;}
.drawer-body{padding:16px 20px;overflow-y:auto;flex:1;}
.drawer-foot{padding:16px 20px;border-top:1px solid var(--line);}
.cart-line{display:flex;justify-content:space-between;gap:8px;padding:10px 0;border-bottom:1px solid var(--line);font-size:14px;}
.cart-line .name{font-weight:600;}
.close-x{background:none;border:none;font-size:20px;color:var(--ink-soft);}
.field{margin-bottom:12px;}
.field label{display:block;font-size:13px;font-weight:600;margin-bottom:4px;}
.field input,.field textarea{width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:var(--radius);background:#fff;}
.field textarea{resize:vertical;min-height:60px;}
.total-row{display:flex;justify-content:space-between;font-weight:700;font-size:16px;margin-bottom:12px;}

.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--primary-dark);color:#fff;padding:10px 18px;border-radius:var(--radius);font-size:14px;z-index:60;}

.login-wrap{max-width:360px;margin:60px auto;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:28px;}
.login-wrap h2{margin-top:0;}
.tabbar{display:flex;gap:4px;border-bottom:1px solid var(--line);margin-bottom:20px;}
.tabbar button{background:none;border:none;padding:10px 14px;font-weight:600;font-size:14px;color:var(--ink-soft);border-bottom:2px solid transparent;}
.tabbar button.active{color:var(--primary);border-color:var(--primary);}
table{width:100%;border-collapse:collapse;background:var(--surface);}
th,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--line);font-size:14px;}
th{color:var(--ink-soft);font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:0.04em;}
.badge{display:inline-block;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:600;}
.badge.new{background:var(--accent-soft);color:#6B4A0F;}
.badge.contacted{background:#DCE6DE;color:var(--primary-dark);}
.badge.delivered{background:var(--primary);color:#fff;}
.badge.cancelled{background:var(--alert-soft);color:var(--alert);}
.row-actions{display:flex;gap:6px;flex-wrap:wrap;}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:18px;margin-bottom:20px;}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.top-admin-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;}
.empty-state{padding:40px 20px;text-align:center;color:var(--ink-soft);}
select{padding:6px 8px;border:1px solid var(--line);border-radius:var(--radius);background:#fff;}
footer{max-width:1080px;margin:0 auto;padding:0 24px 40px;font-size:12px;color:var(--ink-soft);}
.error-text{color:var(--alert);font-size:13px;margin-top:8px;}

/* Product photography */
.swatch { overflow: hidden; display:flex; align-items:center; justify-content:center; }
.swatch img { width:100%; height:100%; object-fit:cover; display:block; }
footer a { color: inherit; font-weight: 600; }
